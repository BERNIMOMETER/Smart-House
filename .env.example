# Copy this file to a root-owned file such as /etc/smarthouse/smarthouse.env.
# Do not commit the copied file or any real credentials.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=home.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://home.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0

MQTT_HOST=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your-hivemq-username
MQTT_PASSWORD=your-hivemq-password
MQTT_TLS=1
# Leave blank to use Raspberry Pi OS's system CA store. Set a PEM bundle path
# only when HiveMQ Cloud instructs you to use a different CA chain.
MQTT_TLS_CA_CERTS=
MQTT_CLIENT_ID=smarthouse-django
MQTT_TOPIC_PREFIX=smarthouse
